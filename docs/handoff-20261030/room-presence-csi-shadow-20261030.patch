+        bl.refresh(t)
+        self.assertIn("cyd_still", bl.ref)
+        bl.add(t, "cyd_still", None)   # ignored
+        bl.reset("cyd_still")
+        self.assertNotIn("cyd_still", bl.ref)
+        self.assertNotIn("cyd_still", bl.pts)
+
+    def test_dump_load_roundtrip(self):
+        bl = cf.Baseline()
