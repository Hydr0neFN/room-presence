+        d = json.loads(json.dumps(bl.dump()))
+        b2 = cf.Baseline()
+        b2.load(d)
+        self.assertAlmostEqual(b2.ref["cyd_still"]["loc"], bl.ref["cyd_still"]["loc"], places=2)
+        self.assertAlmostEqual(b2.z("cyd_still", 40), bl.z("cyd_still", 40), places=1)
+
+    def test_info(self):
